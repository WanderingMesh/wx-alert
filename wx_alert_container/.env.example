# Copy to .env and set for this host. Used by docker-compose.yml.

# Serial device for the MeshCore companion radio, as seen on the host.
#
# Use a /dev/serial/by-id/ path, not /dev/ttyACM0 or /dev/ttyUSB0: USB
# enumeration order changes across reboots and a bare device node will
# eventually point at a different device. List candidates with:
#
#   ls -l /dev/serial/by-id/
MESHCORE_DEVICE=/dev/serial/by-id/usb-CHANGE_ME-if00

# Numeric group ID that owns the device on the host.
#
# The container runs as nonroot and needs this as a supplementary group to
# open a root:dialout 660 device. Find it with:
#
#   stat -c '%g %G' "$(readlink -f "$MESHCORE_DEVICE")"
#
# This varies by distribution and there is no safe default: 20 on Debian and
# Ubuntu, 18 on Fedora and the RHEL family (Rocky, Alma, CentOS), 14 on Arch.
# Read it from the device rather than trusting the list above. A wrong value
# fails at startup with a permission error on the serial port.
MESHCORE_DEVICE_GID=20
